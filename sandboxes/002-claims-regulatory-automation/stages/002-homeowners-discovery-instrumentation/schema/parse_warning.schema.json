{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parse_warning.schema.json",
  "title": "ParseWarning",
  "description": "A parser-quality signal that does not stop processing but affects evidence trust.",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "warning_id", "source_id", "source_hash", "parser_run_id", "warning_type", "description"],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "warning_id": { "type": "string" },
    "source_id": { "type": "string" },
    "source_hash": { "type": "string" },
    "parser_run_id": { "type": "string" },
    "warning_type": { "type": "string", "enum": ["extension_mismatch", "reading_order_uncertain", "missing_structure", "encoding_issue", "empty_section", "table_parse_failed", "truncated", "other"] },
    "description": { "type": "string" },
    "block_id": { "type": ["string", "null"] }
  }
}
